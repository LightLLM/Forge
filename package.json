{
  "name": "forge-harness",
  "version": "1.1.0-rc.1",
  "description": "Local-first hybrid autonomous software-engineering harness",
  "type": "module",
  "bin": {
    "forge": "./dist/cli/index.js",
    "forge-harness": "./dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    ".env.example",
    "README.md",
    "LICENSE",
    "docs/INSTALL.md",
    "docs/gui-gateway.md",
    "AGENTS.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src tests",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"docs/**/*.md\" \"*.md\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx src/cli/index.ts",
    "forge": "tsx src/cli/index.ts",
    "prepare": "npm run build",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "keywords": [
    "forge",
    "agent",
    "coding",
    "ollama",
    "openrouter",
    "local-first"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LightLLM/Forge.git"
  },
  "bugs": {
    "url": "https://github.com/LightLLM/Forge/issues"
  },
  "homepage": "https://github.com/LightLLM/Forge#readme",
  "dependencies": {
    "commander": "^13.1.0",
    "postgres": "^3.4.9",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/node": "^22.13.10",
    "@typescript-eslint/eslint-plugin": "^8.26.1",
    "@typescript-eslint/parser": "^8.26.1",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "prettier": "^3.5.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1",
    "vitest": "^3.0.8"
  },
  "packageManager": "pnpm@10.6.5"
}

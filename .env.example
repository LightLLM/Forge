# Forge environment variables (copy to .env — never commit .env)
#
# Local Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# Optional cloud escalation via OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_MAX_COST_USD=1.0

# Forge runtime defaults (overridden by forge.config.json and CLI flags)
FORGE_MODE=local-preferred
FORGE_MAX_TURNS=20
FORGE_MAX_REPAIRS=2
FORGE_TIMEOUT_MINUTES=30
FORGE_DB_PATH=.forge/forge.db

{
  "name": "forge-desktop",
  "version": "1.2.0-rc.1",
  "private": true,
  "description": "Forge Desktop — installable Electron shell for Forge Core",
  "type": "module",
  "main": "main.mjs",
  "author": "LightLLM",
  "license": "MIT",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "prepare:resources": "node ../scripts/prepare-desktop-resources.mjs",
    "build": "pnpm prepare:resources && electron-builder --publish never",
    "build:win": "pnpm prepare:resources && electron-builder --win --publish never",
    "build:mac": "pnpm prepare:resources && electron-builder --mac --publish never",
    "build:linux": "pnpm prepare:resources && electron-builder --linux --publish never",
    "pack": "pnpm prepare:resources && electron-builder --dir --publish never"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "electron": "^35.1.2",
    "electron-builder": "^25.1.8",
    "electron-updater": "^6.3.9"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "build": {
    "appId": "com.lightllm.forge",
    "productName": "Forge",
    "copyright": "Copyright © LightLLM",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.mjs",
      "preload.mjs",
      "sidecar.mjs",
      "loading.html",
      "onboarding.html",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/forge",
        "to": "forge"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "Forge-${version}-Windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Forge"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64"]
        }
      ],
      "category": "public.app-category.developer-tools",
      "artifactName": "Forge-${version}-macOS-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Development",
      "artifactName": "Forge-${version}-Linux-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "LightLLM",
        "repo": "Forge"
      }
    ]
  }
}
